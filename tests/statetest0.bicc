I: REG(0)
THRESHOLD: NUM(20000)
RESET_THRESHOLD: NUM(30000)
INCREMENT: NUM(1)
INCREMENTOR: ADD
CHECK_THRES: GT

SET_I_MUX: MUX

TRUE -> I[1] # Always set value of I

I -> INCREMENTOR
INCREMENT -> INCREMENTOR[1]

INCREMENTOR -> SET_I_MUX[1]
NUM(0) -> SET_I_MUX[2]

I -> CHECK_THRES
THRESHOLD -> CHECK_THRES[1]

I -> DISPLAY("Value of I")
CHECK_THRES -> DISPLAY("Has I surpassed the threshold?")

# PART 2 #
CHECK_RESET: GT
RESET_COND: AND

I -> CHECK_RESET
RESET_THRESHOLD -> CHECK_RESET[1]

CHECK_RESET -> RESET_COND
CHECK_THRES -> RESET_COND[1]

RESET_COND -> SET_I_MUX[0]

SET_I_MUX -> I

RESET_COND -> DISPLAY("RESET?")