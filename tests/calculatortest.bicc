## SUPER BASIC CALCULATOR ##

# Definitions
CALC: ADD
OP_TOGGLE: MUX
KEY_ACC: ADD
ANY_KEY: OR
SUMMER: ADD
OP: REG
INTERM_OP: REG
OP_SELECTION: REG
RESET_OP_MUX: MUX

OP1: REG
OP2: REG

PRESSED_1: FANOUT
PRESSED_2: FANOUT
PRESSED_3: FANOUT
PRESSED_4: FANOUT
PRESSED_5: FANOUT
PRESSED_6: FANOUT
PRESSED_7: FANOUT
PRESSED_8: FANOUT
PRESSED_9: FANOUT

VAL_1: MUX
VAL_2: MUX
VAL_3: MUX
VAL_4: MUX
VAL_5: MUX
VAL_6: MUX
VAL_7: MUX
VAL_8: MUX
VAL_9: MUX

#####

# Toggle selected op #
TRUE -> OP_SELECTION[1]
KEYTOGGLE("\n") -> OP_SELECTION
OP_SELECTION -> OP_TOGGLE
OP1 -> OP_TOGGLE[1]
OP2 -> OP_TOGGLE[2]

# Feed held number keys into adder #
KEYPRESS("1") -> PRESSED_1
KEYPRESS("2") -> PRESSED_2
KEYPRESS("3") -> PRESSED_3
KEYPRESS("4") -> PRESSED_4
KEYPRESS("5") -> PRESSED_5
KEYPRESS("6") -> PRESSED_6
KEYPRESS("7") -> PRESSED_7
KEYPRESS("8") -> PRESSED_8
KEYPRESS("9") -> PRESSED_9

#
PRESSED_1 -> VAL_1
NUM(0) -> VAL_1[1]
NUM(1) -> VAL_1[2]
#
PRESSED_2 -> VAL_2
NUM(0) -> VAL_2[1]
NUM(2) -> VAL_2[2]
#
PRESSED_3 -> VAL_3
NUM(0) -> VAL_3[1]
NUM(3) -> VAL_3[2]
#
PRESSED_4 -> VAL_4
NUM(0) -> VAL_4[1]
NUM(4) -> VAL_4[2]
#
PRESSED_5 -> VAL_5
NUM(0) -> VAL_5[1]
NUM(5) -> VAL_5[2]
#
PRESSED_6 -> VAL_6
NUM(0) -> VAL_6[1]
NUM(6) -> VAL_6[2]
#
PRESSED_7 -> VAL_7
NUM(0) -> VAL_7[1]
NUM(7) -> VAL_7[2]
#
PRESSED_8 -> VAL_8
NUM(0) -> VAL_8[1]
NUM(8) -> VAL_8[2]
#
PRESSED_9 -> VAL_9
NUM(0) -> VAL_9[1]
NUM(9) -> VAL_9[2]
##

VAL_1 -> KEY_ACC[0]
VAL_2 -> KEY_ACC[1]
VAL_3 -> KEY_ACC[2]
VAL_4 -> KEY_ACC[3]
VAL_5 -> KEY_ACC[4]
VAL_6 -> KEY_ACC[5]
VAL_7 -> KEY_ACC[6]
VAL_8 -> KEY_ACC[7]
VAL_9 -> KEY_ACC[8]

PRESSED_1 -> ANY_KEY[0]
PRESSED_2 -> ANY_KEY[1]
PRESSED_3 -> ANY_KEY[2]
PRESSED_4 -> ANY_KEY[3]
PRESSED_5 -> ANY_KEY[4]
PRESSED_6 -> ANY_KEY[5]
PRESSED_7 -> ANY_KEY[6]
PRESSED_8 -> ANY_KEY[7]
PRESSED_9 -> ANY_KEY[8]

KEY_ACC -> SUMMER[0]
OP -> SUMMER[1]

SUMMER -> INTERM_OP
ANY_KEY -> FANOUT -> FANOUT -> INTERM_OP[1] # Use fanout to keep the signal in sync

OP -> OP1
OP -> OP2

OP_SELECTION -> NOT -> OP1[1]
OP_SELECTION -> OP2[1]

KEYPRESS("\n") -> INTERM_OP[2]
INTERM_OP -> RESET_OP_MUX [1]
NUM(0) -> RESET_OP_MUX[2]
RESET_OP_MUX -> OP
TRUE -> OP[1]

OP1 -> CALC[0]
OP2 -> CALC[1]

OP_SELECTION -> DISPLAY("Current operand selection")
OP -> DISPLAY("Current operand value")
CALC -> DISPLAY("RESULT")